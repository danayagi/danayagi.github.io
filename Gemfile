source "https://rubygems.org"

# GitHub Pages の標準構成（github-pages gem）からは離れる。
# ローカルと Actions のビルドを Jekyll 4 系に揃える。本番の GitHub Pages はこの Gemfile を Actions が使う。
gem "jekyll", "~> 4.4.1"
gem "minima", "~> 2.5.2"
gem "webrick", "~> 1.9"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.18"
  gem "jekyll-seo-tag", "~> 2.9"
end
